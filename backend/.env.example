# Main portal backend configuration.
# Copy to `.env` and adjust.

# PostgreSQL via Docker (recommended):
# DATABASE_URL=postgresql+psycopg2://bdgc:bdgc_password@localhost:5432/bdgc_main
# If you leave it blank or unset, SQLite is used instead:
DATABASE_URL=sqlite:///./bdgc_main.db

# JWT secrets — change these in production!
SECRET_KEY=dev-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Where uploaded CVs are stored on disk.
UPLOAD_DIR=C:\Users\mypcl\Desktop\bd-garments-career\real-project\main-portal\backend\uploads